# Copy to .env (gitignored). deploy.sh never pushes .env, so the one on the host
# survives every deploy.

# Only needed when claiming a fresh server — tokens expire ~4 minutes after being
# issued at https://plex.tv/claim
PLEX_CLAIM=

# Used by scripts/health-report.py to post cinema's report to #homelab-logs.
# Prefer the webhook: it can only post, and only to that one channel, which is
# worth having on a host that does not otherwise need Slack credentials at all.
#   Create one at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_LOGS_WEBHOOK_URL=

# Fallback if no webhook is set. Same bot token as forge/.env.
SLACK_BOT_TOKEN=

# Loki ingest credential for the log shipper (same value on every host; bastion's Caddyfile
# holds its bcrypt hash). Generated once on bastion, never typed by hand.
LOKI_USER=alloy
LOKI_PASSWORD=
