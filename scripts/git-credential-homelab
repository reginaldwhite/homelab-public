#!/usr/bin/env bash
# Git credential helper for this repo.
#
# Uses $GITHUB_TOKEN from the environment if it is already exported; otherwise
# sources .secrets.env at the repo root (gitignored, chmod 600). No secret is
# stored in this file.
#
# Wire it up with:
#   git config --local credential.helper '!scripts/git-credential-homelab'

[ "$1" = "get" ] || exit 0

if [ -z "$GITHUB_TOKEN" ]; then
    root="$(git rev-parse --show-toplevel 2>/dev/null)"
    [ -f "$root/.secrets.env" ] && . "$root/.secrets.env"
fi

[ -n "$GITHUB_TOKEN" ] || exit 0

echo "username=${GITHUB_USER:-reginaldwhite}"
echo "password=$GITHUB_TOKEN"
