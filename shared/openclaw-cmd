#!/bin/bash
# openclaw-cmd — the only command OpenClaw's SSH key is allowed to run on this host.
#
# Wired up as a forced command in ~/.ssh/authorized_keys, e.g. on bastion:
#   command="/home/robby/bin/openclaw-cmd wake-forge wake-cinema health",restrict ssh-ed25519 AAAA... openclaw
#
# The verbs this host permits are passed as arguments; the verb the agent asked for
# arrives in $SSH_ORIGINAL_COMMAND. Anything else is refused. The key still
# authenticates as robby, so without this it could run any command that user can —
# and on bastion robby is in the docker group, which is root-equivalent.
#
# Verbs, and where each is granted:
#   wake-forge   bastion  — WoL magic packet (no sudo needed)
#   wake-cinema  bastion  — WoL magic packet
#   wake-vault   bastion  — WoL magic packet (vault has no other remote power-on)
#   health       bastion  — read-only checks for the server-log-monitor cron job: journal
#                cinema     errors, stopped containers, full disks, and (bastion only, where
#                           the logs exist) the outcome of the weekly backup to vault and of
#                           the wake/sleep jobs. Fixed commands, no arguments from the agent.
#   shutdown     forge    — sudo NOPASSWD: /usr/sbin/shutdown
#   suspend      cinema   — sudo NOPASSWD: /bin/systemctl suspend
#
# Deliberately NOT granted: `shutdown` on bastion. bastion runs DNS and the vault
# for the whole house; a prompt-injected agent should not be able to halt it.

set -euo pipefail

FORGE_MAC="88:d7:f6:13:14:3a"
CINEMA_MAC="d0:17:c2:dd:c1:c2"
# vault's NICs are bonded, so the address it presents is not the cabled interface's
# permanent one. Both are sent; either may be the one the hardware matches on.
VAULT_MACS="e0:cb:4e:9d:02:6a e0:cb:4e:80:92:3d"
BROADCAST="192.168.0.255"

requested="${SSH_ORIGINAL_COMMAND:-}"

permitted=1
if [[ $# -gt 0 ]]; then
    for verb in "$@"; do
        [[ "$verb" == "$requested" ]] && permitted=0 && break
    done
fi
if [[ $permitted -ne 0 ]]; then
    echo "openclaw-cmd: refused '${requested:-<none>}' (this host allows: ${*:-none})" >&2
    exit 126
fi

wol() {
    python3 - "$1" "$BROADCAST" <<'PY'
import socket, sys
mac = sys.argv[1].replace(":", "").replace("-", "")
if len(mac) != 12:
    raise SystemExit(f"bad MAC: {sys.argv[1]}")
packet = bytes.fromhex("ff" * 6 + mac * 16)
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
for dest in (sys.argv[2], "255.255.255.255"):
    sock.sendto(packet, (dest, 9))
print("sent")
PY
}

# Each section prints "none" when empty, so an empty section can't be mistaken for
# output that went missing.
section() {
    local title=$1 out; shift
    echo "== $title"
    if ! out=$("$@" 2>&1); then
        echo "CHECK FAILED: $out"
    elif [[ -z "$out" ]]; then
        echo "none"
    else
        echo "$out"
    fi
}

full_disks() { df -h --output=source,size,used,avail,pcent,target | awk 'NR > 1 && int($5) >= 80'; }

# Containers whose exit is the expected end of their job, not a fault. model-loader
# pulls models once at boot and stops (restart: "no" in forge's compose file), so
# without this forge would report a finding every single day and "warn" would stop
# meaning anything. Keep this list as narrow as the NOISE list above: name the exact
# container, never a pattern that could hide a real service stopping.
EXPECTED_EXITED=(
    model-loader
)

stopped_containers() {
    local out name rest expected
    out=$(docker ps --filter status=exited --format '{{.Names}}\t{{.Status}}') || return
    [[ -z "$out" ]] && return 0
    while IFS=$'\t' read -r name rest; do
        [[ -z "$name" ]] && continue
        expected=0
        for e in "${EXPECTED_EXITED[@]}"; do
            if [[ "$name" == "$e" ]]; then expected=1; break; fi
        done
        if [[ $expected -eq 0 ]]; then printf '%s\t%s\n' "$name" "$rest"; fi
    done <<<"$out"
    return 0
}

# The Sunday backup jobs to vault each log one result line, and until this existed
# nothing ever read it: they failed every single week from May to September 2026 —
# wake-forge reported success without checking, and rsync could not create the
# nested destination path — while the logs sat unread on bastion. A backup that
# fails silently is the same as no backup, so its outcome rides out with the health
# check that already reaches Slack twice a day.
#
# Prints nothing when both jobs are recent and clean, and nothing on a host with no
# backup log (only bastion pushes to vault), so "none" stays the healthy reading.
# The power scripts (wake/sleep for forge and vault) each log one result line, and
# until this existed nothing read them either. wake-forge reported success without
# checking for months while the Sunday backup quietly failed; the same log now also
# carries vault's wake and shutdown, which are the only things standing between the
# backup server and never powering on again.
POWER_LOG="/home/robby/logs/power.log"
POWER_JOBS=(wake-forge sleep-forge wake-vault sleep-vault)

power_jobs() {
    [[ -f "$POWER_LOG" ]] || return 0
    local now line ts secs age unit
    now=$(date +%s)
    for job in "${POWER_JOBS[@]}"; do
        line=$(grep -F "[$job]" "$POWER_LOG" | tail -1) || true
        [[ -z "$line" ]] && continue
        # Only the most recent outcome matters: a later success clears an older failure.
        [[ "$line" != *ERROR* ]] && continue
        ts=${line%% *}
        if secs=$(date -d "$ts" +%s 2>/dev/null); then
            age=$(( (now - secs) / 3600 )); unit=h
            (( age > 48 )) && { age=$(( age / 24 )); unit=d; }
            echo "$job: last run FAILED (${age}${unit} ago) -- ${line#* }"
        else
            echo "$job: last run FAILED -- ${line#* }"
        fi
    done
    return 0
}

BACKUP_LOG="/home/robby/logs/backup.log"
BACKUP_MAX_AGE_DAYS=8   # weekly job; 8 gives a late or skipped Sunday one grace day

backup_status() {
    [[ -f "$BACKUP_LOG" ]] || return 0
    local now line ts secs age
    now=$(date +%s)
    for job in backup-to-tower sync-forge; do
        line=$(grep -F "[$job]" "$BACKUP_LOG" | grep -E 'complete|ERROR' | tail -1) || true
        if [[ -z "$line" ]]; then
            echo "$job: no run has ever finished (nothing in $BACKUP_LOG)"
            continue
        fi
        ts=${line%% *}
        if ! secs=$(date -d "$ts" +%s 2>/dev/null); then
            echo "$job: could not read the timestamp on its last log line"
            continue
        fi
        age=$(( (now - secs) / 86400 ))
        if [[ "$line" == *ERROR* ]]; then
            echo "$job: last run (${age}d ago) FAILED -- ${line#* }"
        elif (( age > BACKUP_MAX_AGE_DAYS )); then
            echo "$job: last success was ${age}d ago, expected weekly"
        fi
    done
    return 0
}

# The monitor runs at 7am and 9pm; 14 hours covers the longer gap between runs, so
# nothing logged in between is missed (the shorter overnight gap is checked twice).
WINDOW="14 hours"

# Known-harmless journal entries, hidden so a healthy host reads "none". Each pattern names
# the process and the exact message; anything unfamiliar still reaches the channel.
NOISE=(
    # GDM bug that fires whenever the login screen comes up
    ' gdm3\[[0-9]+\]: Gdm: on_display_(added|removed): assertion .GDM_IS_REMOTE_DISPLAY \(display\). failed$'
    # CPU feature notes printed at every boot
    ' kernel: x86/cpu: (VMX \(outside TXT\) disabled by BIOS|SGX disabled or unsupported by BIOS\.)$'
    # desktop-session apps and the snap firmware notifier, which have no display to run on
    ' systemd\[[0-9]+\]: Failed to start app-gnome-.* - Application launched by gnome-session-binary\.$'
    ' systemd\[[0-9]+\]: Failed to start snap\.firmware-updater\.firmware-notifier\.service '
    # gnome-keyring handling at the desktop login
    ' gdm-password\]\[[0-9]+\]: (gkr-pam: unable to locate daemon control file|pam_unix\(gdm-password:auth\): (conversation failed|auth could not identify password for \[robby\]))$'
    # `sudo -n` probing without a password. A wrong password logs "incorrect password
    # attempts" instead, and that still gets through.
    ' sudo\[[0-9]+\]: +robby : a password is required ; '
    # fwupd's metadata-refresh timer fails on forge whenever LVFS is unreachable at that
    # moment; nothing here installs firmware through it
    ' systemd\[[0-9]+\]: Failed to start fwupd-refresh\.service - Refresh fwupd metadata and update motd\.$'
    # cinema's iGPU drives an HDMI bridge (LSPCON) that is still asleep on every resume;
    # the link recovers by itself and nothing is watching that output
    ' kernel: i915 0000:00:02\.0: \[drm\] \*ERROR\* (LSPCON |DPCD |Failed to write infoframes)'
)

# journalctl, minus NOISE. Captured first so a failing journalctl still reports CHECK FAILED,
# while grep finding nothing to keep (exit 1) just means everything was noise.
journal() {
    local out
    out=$(journalctl "$@" --since "$WINDOW ago" --no-pager -q) || return
    grep -v -E -f <(printf '%s\n' "${NOISE[@]}") <<<"$out" || true
}

# Adding or removing a section here means bumping EXPECTED_SECTIONS in
# shared/health-report.py, which treats a short run as status=error so a truncated
# check can never read as healthy. Leave them disagreeing and every host reports an
# error every day.
health() {
    section "system journal errors, last $WINDOW" journal -p err
    section "stopped containers" stopped_containers
    section "filesystems at 80% or more" full_disks
    section "critical kernel events, last $WINDOW" journal -k -p crit
    section "weekly backup to vault" backup_status
    section "power jobs" power_jobs
}

case "$requested" in
    wake-forge)  wol "$FORGE_MAC" ;;
    wake-cinema) wol "$CINEMA_MAC" ;;
    wake-vault)  for m in $VAULT_MACS; do wol "$m"; done ;;
    shutdown)    sudo -n /usr/sbin/shutdown -h now ;;
    suspend)     sudo -n /bin/systemctl suspend ;;
    health)      health ;;
    *)           echo "openclaw-cmd: unknown verb '$requested'" >&2; exit 126 ;;
esac
