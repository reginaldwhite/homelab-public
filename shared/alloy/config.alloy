// config.alloy — ship this host's logs to Loki on bastion. One file for every host; the host
// name and the Loki endpoint arrive as environment variables from the compose file, so the
// same configuration runs on bastion (straight to loki:3100 on the compose network) and on
// forge and cinema (through Caddy's loki.robbywhite.net with basic auth).
//
// Lives in shared/ and is merged into each host's scripts/ by deploy.sh, which is why the
// compose files mount it from ./scripts/alloy/config.alloy. See docs/plan-observability.md.
//
// Two sources:
//   * journald — every unit on the host, labelled by unit and priority. This is what the old
//     health verb grepped with `journalctl -p err`.
//   * Docker — every container's stdout/stderr, labelled by container name. Alloy reaches the
//     Docker API through a socket proxy that only allows read-only container calls, so this
//     shipper never holds the real socket (which would be root on the host).

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")
    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_PASSWORD")
    }
    tls_config {
      // Caddy's LAN-only vhost uses its internal CA. The hop is inside the house and the
      // credentials above are what actually gate ingestion.
      insecure_skip_verify = true
    }
  }
  external_labels = {
    host = sys.env("ALLOY_HOST"),
  }
}

// ---- journald ------------------------------------------------------------------------
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
}

loki.source.journal "journal" {
  path          = "/var/log/journal"
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = { job = "journal" }
  forward_to    = [loki.write.default.receiver]
}

// ---- Docker containers ---------------------------------------------------------------
discovery.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  refresh_interval = "30s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host          = "tcp://docker-proxy:2375"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  labels        = { job = "docker" }
  forward_to    = [loki.write.default.receiver]
}

// ---- AdGuard Home query log (bastion only) --------------------------------------------
// AdGuard writes one JSON object per lookup to querylog.json. On bastion the compose file
// mounts that directory read-only at /adguard; on every other host the path does not exist,
// the matcher finds nothing, and this whole block is inert. Labels stay low-cardinality:
// the client's IP (a few dozen values) and whether the answer was filtered. The domain is in
// the line, so "which device asked for what" is a line filter, never a label.
local.file_match "adguard" {
  path_targets = [{ __path__ = "/adguard/querylog.json" }]
}

loki.source.file "adguard" {
  targets    = local.file_match.adguard.targets
  forward_to = [loki.process.adguard.receiver]
}

loki.process "adguard" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      T        = "T",
      client   = "IP",
      domain   = "QH",
      qtype    = "QT",
      filtered = "Result.IsFiltered",
      reason   = "Result.Reason",
      rule     = "Result.Rule",
      upstream = "Upstream",
    }
  }
  stage.timestamp {
    source = "T"
    format = "RFC3339Nano"
  }
  // AdGuard omits Result for an unfiltered answer and Upstream for a filtered one; give the
  // label a definite value either way so {filtered="false"} is a real selector.
  stage.template {
    source   = "filtered"
    template = "{{ if eq .filtered \"true\" }}true{{ else }}false{{ end }}"
  }
  stage.labels {
    values = { client = "", filtered = "" }
  }
  stage.static_labels {
    values = { job = "adguard-querylog" }
  }
  // Rewrite the line: the raw record carries the whole DNS answer base64-encoded, which
  // nobody searches for. What is left is what a person reads.
  stage.template {
    source   = "line"
    template = "{{ .client }} {{ .domain }} {{ .qtype }} filtered={{ .filtered }}{{ if .reason }} reason={{ .reason }}{{ end }}{{ if .rule }} rule={{ .rule }}{{ end }}{{ if .upstream }} upstream={{ .upstream }}{{ end }}"
  }
  stage.output {
    source = "line"
  }
}

// ---- syslog from LAN devices (bastion only) ------------------------------------------
// The TP-Link EAP772 access point (192.168.0.2) sends its event log here (Management ->
// System Log -> Enable Server -> 192.168.0.10:1514 UDP) since 2026-10-07; its local log holds
// only boot entries, and client joins, leaves and deauth reasons exist nowhere else. Any other
// LAN device that can speak syslog can be pointed at the same port. The listener is defined on
// every host, but only bastion's compose file publishes the port, so elsewhere it is unreachable.
// Labels: job=syslog, device (the hostname in the message), source_ip, level.
loki.relabel "syslog" {
  forward_to = []
  rule {
    source_labels = ["__syslog_connection_ip_address"]
    target_label  = "source_ip"
  }
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "device"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    target_label  = "level"
  }
}

loki.source.syslog "lan" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "udp"
    syslog_format          = "rfc3164"
    // Stamp on arrival: the devices' clocks are not trusted (the AP lost two hours in the
    // outage until it re-synced), and a line in the wrong hour is worse than one a second late.
    use_incoming_timestamp = false
    labels                 = { job = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.default.receiver]
}
