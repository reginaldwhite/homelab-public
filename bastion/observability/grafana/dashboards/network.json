     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "events"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "select coalesce(name, hostname, '') as device, ip, mac, source, array_to_string(tags, ',') as tags, last_seen from lan_clients order by last_seen desc, ip",
