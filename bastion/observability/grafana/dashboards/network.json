  {
   "id": 31,
   "type": "timeseries",
   "title": "Lookups per client, per 5 min",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (client) (count_over_time({job=\"adguard-querylog\", client=~\"$client\"} |~ \"(?i)$domain\" [5m]))",
     "legendFormat": "{{client}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
