  {
   "type": "table",
   "title": "Finn: top domains in the selected range (allowed)",
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 22
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "topk(25, sum by (domain) (count_over_time({job=\"adguard-querylog\", client=~\"192.168.0.(150|151|157|152|153|154)\", filtered=\"false\"} | pattern \"<ip> <domain> <type> <_>\" [$__range])))",
     "queryType": "instant",
     "legendFormat": "{{domain}}"
    }
   ],
   "transformations": [
    {
     "id": "reduce",
     "options": {
      "reducers": [
       "lastNotNull"
      ],
      "labelsToFields": true
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Field": true
      },
      "renameByName": {
       "domain": "domain",
       "Last *": "lookups"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Last *",
      "desc": true
     }
    ]
   },
