{
 "uid": "homelab-logs",
 "title": "Logs",
 "tags": [
  "homelab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "id": null,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "annotations": {
  "list": []
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "host",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "",
     "type": 1
    },
    "definition": "label_values(host)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": [
      "$__all"
     ]
    },
    "refresh": 1,
    "sort": 1
   },
   {
    "name": "search",
    "type": "textbox",
    "label": "contains",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Errors per host (journald priority err and above)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host) (count_over_time({job=\"journal\", host=~\"$host\", level=~\"err|crit|alert|emerg\"}[5m]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Container log lines per minute",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (host, container) (rate({job=\"docker\", host=~\"$host\"}[5m])) * 60",
     "legendFormat": "{{host}}/{{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "right"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "logs",
   "title": "journald, err and above",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"journal\", host=~\"$host\", level=~\"err|crit|alert|emerg\"} |~ \"(?i)$search\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "dedupStrategy": "none",
    "enableLogDetails": true
   }
  },
  {
   "id": 4,
   "type": "logs",
   "title": "container logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"docker\", host=~\"$host\"} |~ \"(?i)$search\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "dedupStrategy": "none",
    "enableLogDetails": true
   }
  }
 ]
}