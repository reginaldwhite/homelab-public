# Copy to .env on the deployed copy and chmod 600:
#   /home/robby/homelab-deployed/bastion/.env
# deploy.sh never pushes .env, so the one on the host survives every deploy.
#
# SLACK_BOT_TOKEN is required. scripts/digest-watchdog.py has to *read*
# #homelab-status to see whether a digest was posted, and a webhook cannot read.
# Same bot token as forge/.env.
SLACK_BOT_TOKEN=

# Optional. If set, posting uses these instead of the token -- a webhook can only
# post, and only to the one channel it was created for, which is worth having on the
# host that runs the password vault. Reading still uses the token above.
#   Create them at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_LOGS_WEBHOOK_URL=      # -> #homelab-logs   (health-report.py)
SLACK_STATUS_WEBHOOK_URL=    # -> #homelab-status (digest-watchdog.py, and the
                             #    catastrophe bypass in health-report.py)

# --- observability (docs/plan-observability.md) -----------------------------------------
# Grafana's admin login (user "robby"), LAN-only at https://grafana.robbywhite.net.
# apply.sh refuses to bring the stack up while this is empty.
GRAFANA_ADMIN_PASSWORD=
# Key Grafana encrypts data-source secrets with (GF_SECURITY_SECRET_KEY). Generated once with
#   openssl rand -hex 32
# and never changed afterwards: Grafana cannot read secrets encrypted under an old key, so a
# change means removing the observability_grafana_data volume and letting provisioning rebuild.
GRAFANA_SECRET_KEY=

# AdGuard's admin login, the same one the web UI takes. Read by the AdGuard stats script and
# by the agent when it manages rewrites, clients and the children's off-hours rules.
ADGUARD_USER=Robby
ADGUARD_PASSWORD=

# --- IoT pollers (docs/plan-kids-hours-and-iot.md) --------------------------------------
# HUUM app login; the sauna is read from https://api.huum.eu with HTTP basic auth.
HUUM_USERNAME=
HUUM_PASSWORD=
# Rachio: the app -> Profile -> API key -> Copy.
RACHIO_API_KEY=

# Loki ingest credential for the log shipper (same value on every host; bastion's Caddyfile
# holds its bcrypt hash). Generated once on bastion, never typed by hand.
LOKI_USER=alloy
LOKI_PASSWORD=

# Events database (Postgres on bastion, never published). Generated once with
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
# and read by the compose file and by Grafana's provisioned data source.
EVENTS_DB_PASSWORD=

# --- WiFi controllers (docs/plan-wifi.md) -----------------------------------------------
# MongoDB behind the UniFi controller: the root password and the application user's. Both
# generated once with `openssl rand -hex 24` (hex only: UniFi URL-encodes nothing) and read on
# the stack's FIRST start only -- Mongo's init script creates the user with them, and UniFi
# writes them into its system.properties. Changing them afterwards means editing both volumes.
# Nobody types these; the controller logins themselves live in Bitwarden, not here.
UNIFI_MONGO_ROOT_PASSWORD=
UNIFI_MONGO_PASSWORD=

# Read-only access for scripts/wifi-clients.py (phase 4: the wireless columns of the Network
# dashboard). Leave either pair empty and that controller is simply skipped.
#   Omada: Settings -> Platform Integration -> Open API -> Add. Mode "Client Credentials",
#   role Viewer, all sites. Copy the Client ID and Client Secret here.
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
#   A second Open API app with the OPERATOR role, for scripts/omada-ssid.py to change SSIDs,
#   schedules and MAC groups (and later for kids-hours.py to flip the children's SSIDs).
#   Kept separate from the Viewer pair so the read-only poller can never write.
OMADA_ADMIN_CLIENT_ID=
OMADA_ADMIN_CLIENT_SECRET=
#   UniFi: Settings -> Admins & Users -> Add Admin -> "Restrict to local access only",
#   role View Only (or Read Only), any username; its password here. Not the account you log in with.
UNIFI_USER=
UNIFI_PASSWORD=
