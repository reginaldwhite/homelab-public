# Copy to .env on the deployed copy and chmod 600:
#   /home/robby/homelab-deployed/bastion/.env
# deploy.sh never pushes .env, so the one on the host survives every deploy.
#
# SLACK_BOT_TOKEN is required. scripts/digest-watchdog.py has to *read*
# #homelab-status to see whether a digest was posted, and a webhook cannot read.
# Same bot token as forge/.env.
SLACK_BOT_TOKEN=

# Optional. If set, posting uses these instead of the token -- a webhook can only
# post, and only to the one channel it was created for, which is worth having on the
# host that runs the password vault. Reading still uses the token above.
#   Create them at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_LOGS_WEBHOOK_URL=      # -> #homelab-logs   (health-report.py)
SLACK_STATUS_WEBHOOK_URL=    # -> #homelab-status (digest-watchdog.py, and the
                             #    catastrophe bypass in health-report.py)
