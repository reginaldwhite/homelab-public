# Copy to .env on the deployed copy and chmod 600:
#   /home/robby/homelab-deployed/bastion/.env
# deploy.sh never pushes .env, so the one on the host survives every deploy.
#
# SLACK_BOT_TOKEN is required. scripts/digest-watchdog.py has to *read*
# #homelab-status to see whether a digest was posted, and a webhook cannot read.
# Same bot token as forge/.env.
SLACK_BOT_TOKEN=

# Optional. If set, posting uses these instead of the token -- a webhook can only
# post, and only to the one channel it was created for, which is worth having on the
# host that runs the password vault. Reading still uses the token above.
#   Create them at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_LOGS_WEBHOOK_URL=      # -> #homelab-logs   (health-report.py)
SLACK_STATUS_WEBHOOK_URL=    # -> #homelab-status (digest-watchdog.py, and the
                             #    catastrophe bypass in health-report.py)

# --- observability (docs/plan-observability.md) -----------------------------------------
# Grafana's admin login (user "robby"), LAN-only at https://grafana.robbywhite.net.
# apply.sh refuses to bring the stack up while this is empty.
GRAFANA_ADMIN_PASSWORD=

# AdGuard's admin login, the same one the web UI takes. Read by the AdGuard stats script and
# by the agent when it manages rewrites, clients and the children's off-hours rules.
ADGUARD_USER=Robby
ADGUARD_PASSWORD=

# --- IoT pollers (docs/plan-kids-hours-and-iot.md) --------------------------------------
# HUUM app login; the sauna is read from https://api.huum.eu with HTTP basic auth.
HUUM_USERNAME=
HUUM_PASSWORD=
# Rachio: the app -> Profile -> API key -> Copy.
RACHIO_API_KEY=

# Loki ingest credential for the log shipper (same value on every host; bastion's Caddyfile
# holds its bcrypt hash). Generated once on bastion, never typed by hand.
LOKI_USER=alloy
LOKI_PASSWORD=
