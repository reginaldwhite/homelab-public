# Copy to .env on the deployed copy and chmod 600:
#   /home/robby/homelab-deployed/bastion/.env
# deploy.sh never pushes .env, so the one on the host survives every deploy.
#
# Used by scripts/health-report.sh to post bastion's daily self-check.
# Prefer the webhook: it can only post, to one channel. A bot token can also read
# channel history, and this host runs the password vault.
#   Create one at https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Fallback if no webhook is configured. Same bot token as forge/.env.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=C0C3MAXLSRK
