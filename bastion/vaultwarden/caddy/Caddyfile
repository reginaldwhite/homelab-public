vault.robbywhite.net {
  reverse_proxy vaultwarden:80
  encode gzip
}
# AdGuard Home admin UI. There is no public DNS record for this name, so public ACME
# can never validate it — `tls internal` issues a local cert instead and stops Caddy
# retrying Let's Encrypt forever (which had pushed it to the staging CA).
# AdGuard runs with network_mode: host, so it is reached on the host's LAN address:
# 127.0.0.1 from inside this container is the container itself, not the host.
#
# **Having no public DNS record does not make this private.** Caddy routes on the Host
# header and SNI, not on how the client resolved the name, and 443 is forwarded from
# the internet so that vault.robbywhite.net can get a real certificate. Until the
# remote_ip check below, anyone could reach this admin login from anywhere with
#   curl -k -H 'Host: dns.robbywhite.net' https://<public-ip>/
# and only AdGuard's own password stood behind it. The missing DNS record just meant
# they had to know the name.
#
# 172.16/12 is here because Caddy is in a bridge network: if Docker ever proxies a
# published port rather than DNAT-ing it, the client address Caddy sees is the bridge
# gateway, not the real LAN address. If this ever locks you out of the UI, that is the
# reason — AdGuard is still directly reachable at http://192.168.0.10:8888 on the LAN.
# `abort` rather than a 403, so a prober cannot confirm the vhost exists.
dns.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        reverse_proxy 192.168.0.10:8888
    }
    handle {
        abort
    }
}

# Loki ingest for the shippers on forge and cinema. LAN-only like the others, plus basic auth:
# the credential is LOKI_USER/LOKI_PASSWORD in each host's .env, and this is its bcrypt hash
# (a hash, so it can live in git). bastion's own shipper talks to loki:3100 directly.
loki.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        basic_auth {
            alloy $2a$14$REDACTED-set-your-own-bcrypt-hash-here
        }
        reverse_proxy loki:3100
    }
    handle {
        abort
    }
}

# Grafana, LAN-only, same guard as the AdGuard page above. Grafana runs in the observability
# compose project but joins this stack's network, so it is reached by service name and never
# publishes a port. AdGuard rewrites the name to 192.168.0.10; there is no public record.
grafana.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        reverse_proxy grafana:3000
    }
    handle {
        abort
    }
}

# The WiFi coverage survey page (bastion/wifi/survey). It accepts survey writes from anyone
# who can reach it and serves a download-test blob, so it is LAN-only in the same way.
wifi.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        reverse_proxy wifi-survey:8080
    }
    handle {
        abort
    }
}

# jobhunt (bastion/jobhunt): the job-feed queue. Personal data, so LAN-only like Grafana;
# AdGuard rewrites the name to 192.168.0.10 and there is no public record.
jobs.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        reverse_proxy jobhunt-web:3000
    }
    handle {
        abort
    }
}

# The Omada WiFi controller (bastion/wifi, docs/plan-wifi.md). It runs on the host network, so
# like AdGuard it is reached on the host's LAN address, and it presents its own self-signed
# certificate, hence tls_insecure_skip_verify on the upstream — the hop is loopback-to-container
# on bastion itself. Same LAN-only guard as the others; the UI also answers directly on
# 192.168.0.10:8043 for the LAN. (unifi.robbywhite.net went with the AC Lite on 2026-10-20.)
#
# header_up Host {host}: for an https:// upstream Caddy replaces the Host header with the
# upstream address (it keeps it for plain upstreams). The UniFi controller, when it lived here,
# compared Origin with Host on every POST and answered 403 until the browser's Host was passed
# through unchanged (found 2026-10-09); kept for Omada, which is happy either way.
omada.robbywhite.net {
    tls internal
    @lan remote_ip 192.168.0.0/24 172.16.0.0/12 127.0.0.1/32
    handle @lan {
        reverse_proxy https://192.168.0.10:8043 {
            header_up Host {host}
            transport http {
                tls_insecure_skip_verify
            }
        }
    }
    handle {
        abort
    }
}

