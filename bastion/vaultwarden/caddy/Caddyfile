vault.robbywhite.net {
  reverse_proxy vaultwarden:80
  encode gzip
}
# AdGuard Home admin UI. LAN-only: there is no public DNS record for this name, so
# public ACME can never validate it — `tls internal` issues a local cert instead and
# stops Caddy retrying Let's Encrypt forever (which had pushed it to the staging CA).
# AdGuard runs with network_mode: host, so it is reached on the host's LAN address:
# 127.0.0.1 from inside this container is the container itself, not the host.
dns.robbywhite.net {
    tls internal
    reverse_proxy 192.168.0.10:8888
}
