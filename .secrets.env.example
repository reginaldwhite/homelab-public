# Credentials for pushing this repo to GitHub over HTTPS.
# Copy to .secrets.env (gitignored) and fill in the token:
#   cp .secrets.env.example .secrets.env && chmod 600 .secrets.env
#
# Create a fine-grained PAT at https://github.com/settings/tokens?type=beta
#   Repository access: only select repositories -> reginaldwhite/homelab
#   Permissions: Repository permissions -> Contents -> Read and write
#
# Read by scripts/git-credential-homelab, which is wired in with:
#   git config --local credential.helper '!scripts/git-credential-homelab'

GITHUB_USER=reginaldwhite
GITHUB_TOKEN=
