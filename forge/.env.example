# Copy this file to .env and fill in your values
# cp .env.example .env

# Gateway authentication token - generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Slack integration - create a Slack app at https://api.slack.com/apps
# App token (xapp-...): requires connections:write scope
SLACK_APP_TOKEN=
# Bot token (xoxb-...): requires chat:write, channels:history, etc.
SLACK_BOT_TOKEN=

# Cloud API keys (optional)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Loki ingest credential for the log shipper (same value on every host; bastion's Caddyfile
# holds its bcrypt hash). Generated once on bastion, never typed by hand.
LOKI_USER=alloy
LOKI_PASSWORD=
